local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Helper function for safe teleports
local function Teleport(x, y, z)
    local player = Players.LocalPlayer
    if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        player.Character.HumanoidRootPart.CFrame = CFrame.new(x, y, z)
    end
end

-- ==============================================================================
-- 2. KEY SYSTEM WINDOW (Explicitly shows "Get Key" & "Verify")
-- ==============================================================================
local KeyWindow = Rayfield:CreateWindow({
   Name = "Opex Hub | Key System",
   LoadingTitle = "Authenticating...",
   LoadingSubtitle = "Platoboost Security",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false
})

local KeyTab = KeyWindow:CreateTab("Login", 4483362458)
local UserKeyInput = ""

KeyTab:CreateInput({
   Name = "Enter Your Key",
   PlaceholderText = "Paste KEY_ here...",
   RemoveTextAfterFocusLost = false,
   Callback = function(Text)
      UserKeyInput = Text
   end,
})

KeyTab:CreateButton({
   Name = "Get Key",
   Callback = function()
      copyLink()
      Rayfield:Notify({
         Title = "Link Copied!", 
         Content = "Paste the link in your browser to get your key.", 
         Duration = 5
      })
   end,
})

KeyTab:CreateButton({
   Name = "Verify",
   Callback = function()
      if UserKeyInput == "" then
         Rayfield:Notify({Title = "Error", Content = "Please enter your key first!", Duration = 3})
         return
      end

      -- Live check against Platoboost server
      local isValid = verifyKey(UserKeyInput)

      if isValid then
         Rayfield:Notify({Title = "Success!", Content = "Key verified. Loading Opex Hub...", Duration = 3})
         KeyWindow:Destroy()
         LoadMainHub()
      else
         Rayfield:Notify({Title = "Error", Content = "Invalid or expired key.", Duration = 3})
      end
   end,
})

